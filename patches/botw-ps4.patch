diff --git a/games/botw/game.cpp b/games/botw/game.cpp
new file mode 100644
index 0000000..7a85740
--- /dev/null
+++ b/games/botw/game.cpp
@@ -0,0 +1,42 @@
+// The Legend of Zelda: Breath of the Wild (01007EF00011E000, 1.5.0, the version zeldaret/botw decompiles): what the
+// shared runtime needs to know about the game. It draws through NVN (agl/gsys, an older SDK than Wonder's). Modules:
+// main, sdk and any subsdk (modules.cmake), generated with --base 0x4000000000 (main), 0x4018000000 (+0x8000000 per
+// subsdk) and 0x4010000000 (sdk) (the PS4 port: scripts/prepare-game.sh). main 1.5.0 is generated with the decomp's
+// function list (--symbols: every function start of main, and names).
+#include <cstdlib>
+
+#include <nx/game.h>
+#include <nx/runtime.h>
+
+#ifdef _WIN32
+// The Windows C library has no setenv: the same rule (a value already set stays unless overwrite) through _putenv_s.
+static int setenv(const char* name, const char* value, int overwrite) {
+    if (!overwrite && std::getenv(name)) return 0;
+    return _putenv_s(name, value);
+}
+#endif
+
+namespace nx {
+
+const game::Info game::kInfo = {"botw", "The Legend of Zelda: Breath of the Wild", 0x01007EF00011E000ull,
+                                "io.github.botwrecomp", "private/botw",
+                                game::kSystemResourceFromNpdm /* main.npdm META +0x14 */};
+
+// Runtime defaults for this game (config.txt still overrides them: setenv does not replace a value already set). The
+// same as TOTK's where the reason is the PS4 or the engine family, not TOTK's own renderer.
+void game::after_init() {
+    // NVN API version: nnMain requires major 53 and minor >= 311 (main+e55304, 1.6.0) and otherwise skips its whole
+    // graphics setup (then sead::Graphics::sInstance is null at the first draw-context lock).
+    setenv("NX_NVN_API", "53.311", 0);
+    // nvnMemoryPoolInvalidateMappedRange without waiting for the submits so far (nvn_objects.cpp): TOTK's waits kept
+    // its main thread behind the whole replay.
+    setenv("NX_INVALIDATE_WAIT", "0", 0);
+    // Fragment-shader storage write-backs made every submit wait (TOTK: 20 -> 9 fps).
+    setenv("NX_GRAPHICS_WRITE_BACK", "0", 0);
+    // Depth clamp on the PS4's RADV put every clamped fragment at depth 0 (TOTK's shadow maps): clipped instead.
+    setenv("NX_DEPTH_CLAMP", "0", 0);
+}
+void game::renderer_start() {}
+void game::first_frame() {}
+
+}  // namespace nx
diff --git a/games/botw/modules.cmake b/games/botw/modules.cmake
new file mode 100644
index 0000000..752cf57
--- /dev/null
+++ b/games/botw/modules.cmake
@@ -0,0 +1,10 @@
+# Breath of the Wild's code modules (ExeFS) in rtld order: main, any subsdk*, sdk. Which subsdk modules 1.5.0 ships is
+# not checked against a dump yet, so the build takes every subsdk folder scripts/prepare-game.sh generated.
+set(NX_GAME_MODULES main)
+foreach(i RANGE 0 9)
+    if(EXISTS "${NX_GEN_DIR}/subsdk${i}")
+        list(APPEND NX_GAME_MODULES subsdk${i})
+    endif()
+endforeach()
+list(APPEND NX_GAME_MODULES sdk)
+message(STATUS "BOTW modules: ${NX_GAME_MODULES}")
diff --git a/games/totk/game.cpp b/games/totk/game.cpp
new file mode 100644
index 0000000..fd4ee0a
--- /dev/null
+++ b/games/totk/game.cpp
@@ -0,0 +1,40 @@
+// The Legend of Zelda: Tears of the Kingdom (0100F2C0115B6000, 1.0.0): what the shared runtime needs to know about
+// the game. It draws through NVN like Wonder. Modules: main, subsdk0 and sdk (modules.cmake), generated with
+// --base 0x4000000000 (main), 0x4018000000 (subsdk0) and 0x4010000000 (sdk) (the PS4 port: scripts/prepare-game.sh).
+#include <cstdlib>
+
+#include <nx/game.h>
+#include <nx/runtime.h>
+
+#ifdef _WIN32
+// The Windows C library has no setenv: the same rule (a value already set stays unless overwrite) through _putenv_s.
+static int setenv(const char* name, const char* value, int overwrite) {
+    if (!overwrite && std::getenv(name)) return 0;
+    return _putenv_s(name, value);
+}
+#endif
+
+namespace nx {
+
+const game::Info game::kInfo = {"totk", "The Legend of Zelda: Tears of the Kingdom", 0x0100F2C0115B6000ull,
+                                "io.github.totkrecomp", "private/totk",
+                                game::kSystemResourceFromNpdm /* main.npdm META +0x14 */};
+
+// Runtime defaults for this game (config.txt still overrides them: setenv does not replace a value already set).
+void game::after_init() {
+    // nvnMemoryPoolInvalidateMappedRange without waiting for the submits so far (nvn_objects.cpp): TOTK calls it ~10
+    // times a frame, and the wait kept its main thread behind the whole replay (30-57 ms a frame).
+    setenv("NX_INVALIDATE_WAIT", "0", 0);
+    // Storage that fragment shaders write (v00.17) went back to guest memory with a wait for every submit: 20 -> 9 fps,
+    // and the world stayed black without it too. Off until it can apply without waiting.
+    setenv("NX_GRAPHICS_WRITE_BACK", "0", 0);
+    // The shadow casters draw with depth clamp; on the PS4 every clamped fragment landed at depth 0 (storyboard
+    // v00.23: shadow maps cleared to 1, then 0 everywhere). Clipped instead (nvn_pipeline.cpp).
+    setenv("NX_DEPTH_CLAMP", "0", 0);
+    // The deferred lighting matches material IDs written as depth with EQUAL: kept exact (nvn_pipeline.cpp).
+    setenv("NX_EQUAL_EXACT", "1", 0);
+}
+void game::renderer_start() {}
+void game::first_frame() {}
+
+}  // namespace nx
