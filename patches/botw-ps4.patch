+                      OpConstantComposite = 44, OpFunction = 54, OpFunctionEnd = 56, OpVariable = 59, OpLoad = 61,
+                      OpAccessChain = 65, OpInBoundsAccessChain = 66, OpIsNan = 156, OpSelect = 169,
+                      StorageInput = 1 };
