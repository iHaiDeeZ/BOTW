+        if (op == OpTypeBool) b = in[i + 1];
+        if (op == OpTypeFloat && len == 3 && in[i + 2] == 32) f32 = in[i + 1];
+        if (op == OpTypeVector && len == 4 && in[i + 3] == 4) vec_of[in[i + 1]] = in[i + 2];
