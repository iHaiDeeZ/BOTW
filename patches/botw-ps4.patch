+void sleep_ns(int64_t ns) {
+    if (ns <= 0) {
+        sched_yield();
+        return;
+    }
+    timespec ts{time_t(ns / 1000000000), long(ns % 1000000000)};
+    while (nanosleep(&ts, &ts) == -1 && errno == EINTR) {
+    }
+}
+
+void yield() { sched_yield(); }
