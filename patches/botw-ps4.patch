+    if (profile_requested()) ps4_sampler_register_thread(role == 0 ? "replay" : "game main");
+    Known* k = known(ps4_thread_id());
+    if (k && k->guest) return;  // a guest thread presents (NX_REPLAY_THREAD=0): it keeps its guest core
+    if (role == 0) {
